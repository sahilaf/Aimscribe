  {
   "speaker": "SPEAKER_00",
   "start": 15.167843750000003,
   "end": 19.30221875,
   "overlap": false,
   "text": "জি দশ বছরের ডায়াবেটিস উনি গ্লিক্লাজাইড আশি মিলিগ্রাম খান",
   "role": "Attendant"
  },
  {
   "speaker": "SPEAKER_01",
   "start": 19.94346875,
   "end": 21.512843750000002,
   "overlap": false,
   "text": "সুগার শেষ কবে মেপেছিলেন",
