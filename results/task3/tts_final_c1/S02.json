  },
  {
   "speaker": "SPEAKER_01",
   "start": 30.86159375,
   "end": 33.40971875,
   "overlap": true,
   "text": "এটা ডায়াবেটিক ফুড ড্রেসিং করতে হবে",
   "role": "Doctor"
  },
  {
   "speaker": "SPEAKER_01",
   "start": 33.713468750000004,
   "end": 35.51909375,
   "overlap": false,
   "text": "আর একটা কালচার টেস্ট রাখবি",
   "role": "Doctor"
  },
  {
   "speaker": "SPEAKER_01",
   "start": 36.04221875,
   "end": 40.21034375,
   "overlap": false,
   "text": "ইনসুলিন শুরু করা দরকার আর এইচবিএন সি টেস্ট করাবেন",
   "role": "Doctor"
  },
  {
   "speaker": "SPEAKER_00",
   "start": 40.986593750000004,
   "end": 43.01159375,
   "overlap": false,
   "text": "ইনসুলিন কি সারা জীবন নিতে হবে",
