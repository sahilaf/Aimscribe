  },
  {
   "speaker": "SPEAKER_00",
   "start": 21.95159375,
   "end": 24.33096875,
   "overlap": false,
   "text": "গত সপ্তাহে খালি পেটে বারো ছিল",
   "role": "Attendant"
  },
  {
   "speaker": "SPEAKER_01",
   "start": 24.90471875,
   "end": 28.16159375,
   "overlap": false,
   "text": "অনেক বেশি পায়ে কি ব্যথা টের পান না অবশ্য লাগে",
   "role": "Doctor"
  },
  {
   "speaker": "SPEAKER_00",
   "start": 28.735343750000002,
   "end": 31.13159375,
   "overlap": true,
   "text": "উনি বলেন পায়ে তেমন কিছু টের পান",
