  },
  {
   "speaker": "SPEAKER_00",
   "start": 2.76471875,
   "end": 6.00471875,
   "overlap": false,
   "text": "আমার আব্বাকে নিয়ে এসেছি ওনার পায়ে একটা ঘা হয়েছে",
   "role": "Attendant"
  },
  {
   "speaker": "SPEAKER_01",
   "start": 6.679718750000001,
   "end": 9.059093750000002,
   "overlap": false,
   "text": "ওয়ালাইকুম আসসালাম ঘা কতদিনে",
