  },
  {
   "speaker": "SPEAKER_00",
   "start": 9.83534375,
   "end": 12.704093750000002,
   "overlap": false,
   "text": "প্রায় তিন সপ্তাহ শুকাচ্ছে না বরং বড় হচ্ছে",
   "role": "Attendant"
  },
  {
   "speaker": "SPEAKER_01",
   "start": 13.244093750000001,
   "end": 14.57721875,
   "overlap": false,
   "text": "ওনার কি ডায়াবেটিস আছে",
