[
 {
  "speaker": "Speaker0",
  "start": 2.513,
  "end": 3.84,
  "text": "কী করছ?"
 },
 {
  "speaker": "Speaker1",
  "start": 4.74,
  "end": 10.12,
  "text": "আমি এই যে মুড়ি খাবার করলুম। পরে এই ঠাকুরের পুজো টুজো করব, চান করব।"
 },
 {
  "speaker": "Speaker0",
  "start": 7.106,
  "end": 7.606,
  "text": "ও"
 },
 {
  "speaker": "Speaker0",
  "start": 10.74,
  "end": 15.92,
  "text": "আচ্ছা । হ্যাঁ শরীর ভালো।"
 },
 {
  "speaker": "Speaker1",
  "start": 13.261,
  "end": 14.468,
  "text": "শরীর ভালো ?"
 },
 {
  "speaker": "Speaker1",
  "start": 16.45,
  "end": 18.497,
  "text": "আচ্ছা তোদের রান্না চেপে গেছে?"
 },
 {
  "speaker": "Speaker0",
  "start": 18.803,
  "end": 20.37,
  "text": "না না এখনো চাপেনি ।"
 },
 {
  "speaker": "Speaker1",
  "start": 20.955,
  "end": 23.422,
  "text": "ও আচ্ছা । [Noise]"
 },
 {
  "speaker": "Speaker1",
  "start": 22.25,
  "end": 22.27,
  "text": "আচ্ছা ।"
 },
 {
  "speaker": "Speaker0",
  "start": 23.876,
  "end": 24.332,
  "text": "হ্যাঁ"
 },
 {
  "speaker": "Speaker1",
  "start": 24.33,
  "end": 35.21,
  "text": "আমাদের এরপর দেখ না মাকে এই  মুড়ি দিলুম । মা মুড়ি খেল, কাকা মুড়ি খেল । গাই দোওয়া হলো । তারপর এরপর চানটান করে ঠাকুর পুজো  করে তারপর রান্না চাপাবো । [Noise]"
 },
 {
  "speaker": "Speaker0",
  "start": 27.384,
  "end": 28.814,
  "text": "ঠিক, হ্যাঁ"
 },
 {
  "speaker": "Speaker0",
  "start": 35.523,
  "end": 36.237,
  "text": "আচ্ছা ।"
 },
 {
  "speaker": "Speaker0",
  "start": 37.054,
  "end": 38.74,
  "text": "আর তোমার দাঁতের যন্ত্রণা কমেছে?"
 },
 {
  "speaker": "Speaker1",
  "start": 40.08,
  "end": 45.803,
  "text": "না না রাত্রের দিকে দাঁতে দাঁত ঠেকলেই যন্ত্রণা হচ্ছে নাহলে এমনি ভালো আছি ওষুধ খেয়ে এখন ভালো ।"
 },
 {
  "speaker": "Speaker0",
  "start": 46.449,
  "end": 47.195,
  "text": "আচ্ছা ।"
 },
 {
  "speaker": "Speaker0",
  "start": 48.31,
  "end": 51.25,
  "text": "আর ইয়ে বলছি ।"
 },
 {
  "speaker": "Speaker1",
  "start": 52.074,
  "end": 53.357,
  "text": "রিও কী করছে রিও ?"
 },
 {
  "speaker": "Speaker0",
  "start": 53.717,
  "end": 55.395,
  "text": "রিও এই যো খেলছে ।"
 },
 {
  "speaker": "Speaker1",
  "start": 56.196,
  "end": 57.19,
  "text": "আচ্ছা ।"
 },
 {
  "speaker": "Speaker1",
  "start": 58.647,
  "end": 60.287,
  "text": "আর রিও বদমাইশি করছে নাকি?"
 },
 {
  "speaker": "Speaker0",
  "start": 60.503,
  "end": 62.143,
  "text": "না না আর কিছু করেনি ।"
 },
 {
  "speaker": "Speaker1",
  "start": 63.53,
  "end": 65.61,
  "text": "ও"
 },
 {
  "speaker": "Speaker1",
  "start": 66.21,
  "end": 72.857,
  "text": "আমাদের সব ওই চলছে কি মোটামুটি শরীর বেশ একটা যুত নেই । শরীর বেশ ভালো না ।"
 },
 {
  "speaker": "Speaker0",
  "start": 70.749,
  "end": 71.249,
  "text": "ঠিক আছে ।"
 },
 {
  "speaker": "Speaker0",
  "start": 72.218,
  "end": 72.978,
  "text": "ঠিক আছে ।"
 },
 {
  "speaker": "Speaker1",
  "start": 74.376,
  "end": 75.04,
  "text": "আচ্ছা ।"
 }
]