[
 {
  "speaker": "3bea8",
  "start": 0.5,
  "end": 1.3,
  "text": "ভোরের পাতা"
 },
 {
  "speaker": "93bf3",
  "start": 2.071,
  "end": 3.671,
  "text": "তাহলে রবীন্দ্রনাথের"
 },
 {
  "speaker": "3bea8",
  "start": 4.498,
  "end": 9.298,
  "text": "রাজধানী ঢাকায় সকাল থেকেই ঈদ উদযাপিত হয়েছে নানা আয়োজনের মধ্যে দিয়ে"
 },
 {
  "speaker": "93bf3",
  "start": 9.823,
  "end": 11.723,
  "text": "কেশিনিধনের কথা"
 },
 {
  "speaker": "0c39f",
  "start": 11.96,
  "end": 13.16,
  "text": "ভেজাল থাকলে"
 },
 {
  "speaker": "3bea8",
  "start": 13.991,
  "end": 16.191,
  "text": "গাত্রোত্থান করিয়া সমুদ্রের দিকে"
 },
 {
  "speaker": "93bf3",
  "start": 16.948,
  "end": 19.048,
  "text": "কৃষ্ণচরিত্রের প্রসঙ্গ নাই"
 },
 {
  "speaker": "3bea8",
  "start": 19.188,
  "end": 21.088,
  "text": "মোহাম্মদপুর টাউন হলের কাছেই"
 },
 {
  "speaker": "93bf3",
  "start": 21.907,
  "end": 23.107,
  "text": "হাতের নাগালে"
 },
 {
  "speaker": "0c39f",
  "start": 23.936,
  "end": 26.236,
  "text": "মোট দশটি খেলা খেলেছে বাংলাদেশ"
 },
 {
  "speaker": "93bf3",
  "start": 26.464,
  "end": 29.664,
  "text": "তখন এ সমাজ ঈশ্বর গুপ্তের"
 },
 {
  "speaker": "3bea8",
  "start": 30.611,
  "end": 32.811,
  "text": "প্রত্যক্ষদর্শী ও শ্রমিকরা জানান"
 },
 {
  "speaker": "0c39f",
  "start": 33.671,
  "end": 34.871,
  "text": "চূড়ান্ত হতে পারে"
 },
 {
  "speaker": "93bf3",
  "start": 35.428,
  "end": 36.928,
  "text": "বেশ কিছু সেতু"
 },
 {
  "speaker": "3bea8",
  "start": 37.922,
  "end": 39.322,
  "text": "কিয়েভের নিয়ন্ত্রণ থেকে"
 },
 {
  "speaker": "0c39f",
  "start": 39.604,
  "end": 41.404,
  "text": "শামসুজ্জামান খান"
 },
 {
  "speaker": "93bf3",
  "start": 40.848,
  "end": 42.648,
  "text": "ট্রাইব্যুনাল বলেছেন"
 },
 {
  "speaker": "3bea8",
  "start": 43.535,
  "end": 45.335,
  "text": "তবুও প্রতিটি ছবির জন্য"
 },
 {
  "speaker": "93bf3",
  "start": 45.549,
  "end": 46.849,
  "text": "বিতর্ক থেকে"
 },
 {
  "speaker": "0c39f",
  "start": 47.787,
  "end": 48.487,
  "text": "বাজার"
 },
 {
  "speaker": "93bf3",
  "start": 49.372,
  "end": 53.772,
  "text": "আরব্যোপন্যাসের গল্প"
 },
 {
  "speaker": "0c39f",
  "start": 54.37,
  "end": 56.67,
  "text": "পরে জানি অন্তঃসত্ত্বা"
 },
 {
  "speaker": "93bf3",
  "start": 54.879,
  "end": 55.979,
  "text": "দিপু মনি"
 },
 {
  "speaker": "93bf3",
  "start": 56.882,
  "end": 58.882,
  "text": "চিমটি কাটতে হচ্ছে তার"
 },
 {
  "speaker": "0c39f",
  "start": 59.562,
  "end": 61.562,
  "text": "জবানবন্দী রেকর্ড করেন"
 },
 {
  "speaker": "3bea8",
  "start": 62.521,
  "end": 63.921,
  "text": "তাঁহারা যজ্ঞোদ্ভূত"
 },
 {
  "speaker": "93bf3",
  "start": 64.894,
  "end": 65.894,
  "text": "বলে উল্লেখ"
 },
 {
  "speaker": "0c39f",
  "start": 66.598,
  "end": 67.898,
  "text": "অনুপমার প্রেম"
 },
 {
  "speaker": "3bea8",
  "start": 68.46,
  "end": 70.26,
  "text": "শিশু শ্রমিক রয়েছে দেশটিতে"
 },
 {
  "speaker": "93bf3",
  "start": 70.694,
  "end": 71.994,
  "text": "বেলারুশ দেশ"
 },
 {
  "speaker": "0c39f",
  "start": 72.835,
  "end": 74.335,
  "text": "কি নিয়ে ভাবছেন"
 },
 {
  "speaker": "93bf3",
  "start": 74.548,
  "end": 76.448,
  "text": "পাহাড়ের প্রায় অর্ধেক পথ"
 }
]