[
 {
  "speaker": "b08d0",
  "start": 0.5,
  "end": 1.7,
  "text": "তাহাকে বুঝানো"
 },
 {
  "speaker": "121bd",
  "start": 2.114,
  "end": 3.314,
  "text": "ত্রাণ কাজে নিয়োজিত"
 },
 {
  "speaker": "b08d0",
  "start": 3.563,
  "end": 5.563,
  "text": "যোগ্যতার ভিত্তিতেই তাকে"
 },
 {
  "speaker": "121bd",
  "start": 5.782,
  "end": 7.282,
  "text": "হোমস চেঁচিয়ে উঠল"
 },
 {
  "speaker": "b08d0",
  "start": 7.603,
  "end": 9.203,
  "text": "অধ্যাপক তালিম হোসেন"
 },
 {
  "speaker": "121bd",
  "start": 8.813,
  "end": 9.613,
  "text": "ইরোটিক ছবি"
 },
 {
  "speaker": "b08d0",
  "start": 9.942,
  "end": 11.242,
  "text": "ঘুরে ফিরে আসে"
 },
 {
  "speaker": "121bd",
  "start": 11.997,
  "end": 12.797,
  "text": "নিতে পারবেন"
 },
 {
  "speaker": "b08d0",
  "start": 13.01,
  "end": 14.61,
  "text": "এ ব্যাপারে চাপ দিচ্ছে"
 },
 {
  "speaker": "121bd",
  "start": 15.371,
  "end": 16.671,
  "text": "নিজের মালিকানাধীন"
 },
 {
  "speaker": "b08d0",
  "start": 17.393,
  "end": 18.793,
  "text": "আমি অনুরোধ করলাম"
 },
 {
  "speaker": "121bd",
  "start": 19.356,
  "end": 19.756,
  "text": "ঠেলা"
 },
 {
  "speaker": "b08d0",
  "start": 20.672,
  "end": 22.172,
  "text": "ক্যারিয়ারের দিকেই"
 },
 {
  "speaker": "121bd",
  "start": 22.876,
  "end": 24.776,
  "text": "জাফর যেন অন্য জগতে আছে"
 },
 {
  "speaker": "b08d0",
  "start": 24.991,
  "end": 26.791,
  "text": "উপস্থাপিত হওয়ার যোগ্য"
 },
 {
  "speaker": "121bd",
  "start": 27.69,
  "end": 28.89,
  "text": "কই যাস এত রাইতে"
 },
 {
  "speaker": "b08d0",
  "start": 28.801,
  "end": 29.501,
  "text": "বিবর্তন"
 },
 {
  "speaker": "121bd",
  "start": 30.327,
  "end": 31.327,
  "text": "লেয়ার করে"
 },
 {
  "speaker": "b08d0",
  "start": 31.986,
  "end": 33.886,
  "text": "একপর্যায়ে তারেকের সঙ্গে"
 },
 {
  "speaker": "121bd",
  "start": 34.598,
  "end": 35.598,
  "text": "নুরুল আলম বলেন"
 },
 {
  "speaker": "b08d0",
  "start": 36.556,
  "end": 38.256,
  "text": "খবর পেয়েপুলিশ এসে"
 },
 {
  "speaker": "121bd",
  "start": 38.867,
  "end": 40.467,
  "text": "সুগন্ধি প্রদায়ক উদ্ভিদ"
 },
 {
  "speaker": "b08d0",
  "start": 41.177,
  "end": 44.677,
  "text": "নিজেদের মাঠ সান্টিয়াগো বার্নাব্যুতে"
 },
 {
  "speaker": "121bd",
  "start": 44.888,
  "end": 46.088,
  "text": "তাদের মনোপুত হয়"
 },
 {
  "speaker": "b08d0",
  "start": 46.315,
  "end": 47.915,
  "text": "হারকিউলিস নামের"
 },
 {
  "speaker": "121bd",
  "start": 48.878,
  "end": 50.278,
  "text": "বাংলাদেশের রাষ্ট্রপতি"
 },
 {
  "speaker": "b08d0",
  "start": 50.004,
  "end": 51.504,
  "text": "আপিল আবেদন করা হয়"
 },
 {
  "speaker": "121bd",
  "start": 52.212,
  "end": 54.112,
  "text": "এই অভিযোগ ওঠার পর থেকে"
 },
 {
  "speaker": "b08d0",
  "start": 54.964,
  "end": 56.464,
  "text": "লবণ হলুদের সঙ্গে"
 },
 {
  "speaker": "121bd",
  "start": 57.318,
  "end": 60.218,
  "text": "নজরুল তাই প্রলয়কর্তা শিবের মতো"
 },
 {
  "speaker": "b08d0",
  "start": 60.857,
  "end": 62.757,
  "text": "বিষয়টি পর্যালোচনা করে"
 },
 {
  "speaker": "121bd",
  "start": 63.584,
  "end": 66.384,
  "text": "তরুণ কসবার টিআলী ডিগ্রি কলেজের"
 },
 {
  "speaker": "b08d0",
  "start": 66.787,
  "end": 68.687,
  "text": "ইতিবৃত্ত বিষয়ক গ্রন্থে"
 },
 {
  "speaker": "121bd",
  "start": 69.531,
  "end": 70.631,
  "text": "হাঁচির উদ্ভব হয়"
 },
 {
  "speaker": "b08d0",
  "start": 71.087,
  "end": 72.887,
  "text": "অ্যালুমিনিয়াম প্রকৃতিতে"
 },
 {
  "speaker": "121bd",
  "start": 73.103,
  "end": 74.703,
  "text": "নারীর যৌন কামনা থাকতে নেই"
 },
 {
  "speaker": "b08d0",
  "start": 74.971,
  "end": 76.371,
  "text": "বাংলাভাষীদের নিকট"
 }
]