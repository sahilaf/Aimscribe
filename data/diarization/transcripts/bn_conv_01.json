[
 {
  "speaker": "c4973",
  "start": 0.5,
  "end": 2.0,
  "text": "জানান মি কাদের"
 },
 {
  "speaker": "7898e",
  "start": 2.425,
  "end": 4.825,
  "text": "এই ধারাবাহিক নাটকগুলোর বাইরেও"
 },
 {
  "speaker": "c4973",
  "start": 5.773,
  "end": 7.273,
  "text": "কে অস্বীকার করবে"
 },
 {
  "speaker": "7898e",
  "start": 7.725,
  "end": 9.825,
  "text": "আইনী পরিবর্তনসহ"
 },
 {
  "speaker": "c4973",
  "start": 10.049,
  "end": 12.449,
  "text": "ইতোমধ্যে আমনের নতুন চাল"
 },
 {
  "speaker": "7898e",
  "start": 12.275,
  "end": 15.575,
  "text": "হাই কমিশনার নাভি পিল্লাই"
 },
 {
  "speaker": "c4973",
  "start": 16.378,
  "end": 18.278,
  "text": "শরিয়া আইন চালু রেখেছিল"
 },
 {
  "speaker": "7898e",
  "start": 18.918,
  "end": 21.018,
  "text": "সমস্ত গাছই উচ্চতায় বিশাল"
 },
 {
  "speaker": "c4973",
  "start": 21.456,
  "end": 22.456,
  "text": "পালিয়ে গেলেও"
 },
 {
  "speaker": "7898e",
  "start": 22.292,
  "end": 23.292,
  "text": "ওয়াং থিনের"
 },
 {
  "speaker": "c4973",
  "start": 23.893,
  "end": 25.193,
  "text": "পৃথিবীর প্রাচীন"
 },
 {
  "speaker": "7898e",
  "start": 25.659,
  "end": 27.659,
  "text": "মহিলা বিভাগে ব্রোঞ্জ পদক"
 },
 {
  "speaker": "c4973",
  "start": 28.054,
  "end": 30.054,
  "text": "পেপার ব্যাক বইয়ের প্রচলন"
 },
 {
  "speaker": "7898e",
  "start": 30.445,
  "end": 32.045,
  "text": "নিঃস্বার্থ ভালোবাসা"
 },
 {
  "speaker": "c4973",
  "start": 32.262,
  "end": 34.362,
  "text": "রাণীক্ষেত ও রাণীগঞ্জ নদীতে"
 },
 {
  "speaker": "7898e",
  "start": 34.73,
  "end": 35.33,
  "text": "ভ্যান"
 },
 {
  "speaker": "c4973",
  "start": 35.23,
  "end": 37.43,
  "text": "রাজশাহী মেডিকেল কলেজ হাসপাতালে"
 },
 {
  "speaker": "7898e",
  "start": 37.392,
  "end": 39.292,
  "text": "ইন্টারনেটে রায় পাওয়া গেছে"
 },
 {
  "speaker": "c4973",
  "start": 40.009,
  "end": 41.809,
  "text": "সরকার পদক্ষেপ নিয়েছে"
 },
 {
  "speaker": "7898e",
  "start": 42.109,
  "end": 47.309,
  "text": "সেই পটভূমিতে ইউরোপীয় ক্রেতা প্রতিষ্ঠানগুলো এই পদক্ষেপ নেয়"
 },
 {
  "speaker": "c4973",
  "start": 47.579,
  "end": 48.079,
  "text": "হবে না"
 },
 {
  "speaker": "7898e",
  "start": 48.939,
  "end": 49.739,
  "text": "আজই তাদের"
 },
 {
  "speaker": "c4973",
  "start": 49.439,
  "end": 50.039,
  "text": "বধূ"
 },
 {
  "speaker": "7898e",
  "start": 50.056,
  "end": 51.756,
  "text": "গণহত্যা চালানোর পর"
 },
 {
  "speaker": "c4973",
  "start": 52.056,
  "end": 53.756,
  "text": "জানিয়েছেন সৌদি আরবে"
 },
 {
  "speaker": "7898e",
  "start": 54.059,
  "end": 55.959,
  "text": "থানায় মামলা নেয়নি পুলিশ"
 },
 {
  "speaker": "c4973",
  "start": 56.103,
  "end": 57.103,
  "text": "হলো সংসদ"
 },
 {
  "speaker": "7898e",
  "start": 57.613,
  "end": 59.313,
  "text": "বৃত্তির ব্যবস্থা করেছি"
 },
 {
  "speaker": "c4973",
  "start": 59.943,
  "end": 60.943,
  "text": "কঠিন কিছু নয়"
 },
 {
  "speaker": "7898e",
  "start": 61.815,
  "end": 63.415,
  "text": "সকালে বৃষ্টির মধ্যে"
 },
 {
  "speaker": "c4973",
  "start": 63.812,
  "end": 64.812,
  "text": "টেবিলের ওপর"
 },
 {
  "speaker": "7898e",
  "start": 65.03,
  "end": 67.33,
  "text": "লেজের আশপাশে কামড়ানোর সময়"
 },
 {
  "speaker": "c4973",
  "start": 67.594,
  "end": 69.494,
  "text": "ছোটবেলায় এই শহরের"
 },
 {
  "speaker": "7898e",
  "start": 69.876,
  "end": 71.276,
  "text": "মানসুরের এই দাবির"
 },
 {
  "speaker": "c4973",
  "start": 70.908,
  "end": 72.008,
  "text": "সমালোচনা করেন"
 },
 {
  "speaker": "c4973",
  "start": 72.612,
  "end": 74.112,
  "text": "বেশ হাড্ডাহাড্ডি লড়াই"
 },
 {
  "speaker": "c4973",
  "start": 74.924,
  "end": 76.724,
  "text": "মার্চ করে ঢাকায় আসবে"
 }
]