[
 {
  "speaker": "f280a",
  "start": 0.5,
  "end": 2.2,
  "text": "এক আবেদনের শুনানি শেষে"
 },
 {
  "speaker": "9fa90",
  "start": 3.085,
  "end": 4.785,
  "text": "এ সময় পাশে ছিলেন"
 },
 {
  "speaker": "f280a",
  "start": 4.407,
  "end": 6.007,
  "text": "টার্মিনাল এখন যাত্রীশূন্য"
 },
 {
  "speaker": "9fa90",
  "start": 6.494,
  "end": 9.394,
  "text": "পমফ্রেট মাছের পেট পরিষ্কার করে"
 },
 {
  "speaker": "f280a",
  "start": 10.312,
  "end": 11.412,
  "text": "পৃথিবীর নানা দিকেই"
 },
 {
  "speaker": "9fa90",
  "start": 11.43,
  "end": 12.43,
  "text": "শবে মেরাজ"
 },
 {
  "speaker": "f280a",
  "start": 13.132,
  "end": 14.632,
  "text": "সড়কে যান চলাচল"
 },
 {
  "speaker": "9fa90",
  "start": 15.031,
  "end": 17.831,
  "text": "দুইটি বিবরণ পরস্পরবিরোধী হইলে"
 },
 {
  "speaker": "f280a",
  "start": 17.391,
  "end": 19.591,
  "text": "সুপারিশ সমর্থন দিচ্ছেন ব্যবসায়ীরাও"
 },
 {
  "speaker": "9fa90",
  "start": 20.149,
  "end": 21.549,
  "text": "বাংলা পিকচার"
 },
 {
  "speaker": "f280a",
  "start": 21.468,
  "end": 23.468,
  "text": "স্পিকার মীরা কুমারসহ"
 },
 {
  "speaker": "9fa90",
  "start": 23.63,
  "end": 26.03,
  "text": "ওই ছাত্রী বিভাগীয় প্রধান বরাবর"
 },
 {
  "speaker": "f280a",
  "start": 25.828,
  "end": 26.828,
  "text": "বেশ সুন্দর"
 },
 {
  "speaker": "9fa90",
  "start": 27.443,
  "end": 29.943,
  "text": "অনেকে মোবাইল ব্যাংকিংয়ের মাধ্যমে"
 },
 {
  "speaker": "f280a",
  "start": 29.709,
  "end": 31.809,
  "text": "সর্বশেষ শুক্রবার"
 },
 {
  "speaker": "9fa90",
  "start": 32.775,
  "end": 34.075,
  "text": "অবতীর্ণ হন"
 },
 {
  "speaker": "f280a",
  "start": 34.452,
  "end": 36.552,
  "text": "সমর্থিত প্রার্থী এ এ মান্নান"
 },
 {
  "speaker": "9fa90",
  "start": 37.011,
  "end": 38.411,
  "text": "তিনটি মূল স্তর"
 },
 {
  "speaker": "f280a",
  "start": 38.814,
  "end": 39.914,
  "text": "দুর্নীতি যারা করে"
 },
 {
  "speaker": "9fa90",
  "start": 40.519,
  "end": 41.919,
  "text": "বিক্ষোভ মিছিলটি"
 },
 {
  "speaker": "f280a",
  "start": 42.442,
  "end": 43.942,
  "text": "এগিয়ে গেলেন রাস্তার ধারে"
 },
 {
  "speaker": "9fa90",
  "start": 43.605,
  "end": 45.105,
  "text": "হাওয়ায় উড়িয়ে চুল"
 },
 {
  "speaker": "f280a",
  "start": 45.593,
  "end": 46.893,
  "text": "ইউরোপে রপ্তানি করে"
 },
 {
  "speaker": "9fa90",
  "start": 47.799,
  "end": 49.499,
  "text": "শতকরা কুড়ি ভাগ"
 },
 {
  "speaker": "f280a",
  "start": 50.384,
  "end": 51.584,
  "text": "ফাঁকা আওয়াজ মাত্র"
 },
 {
  "speaker": "9fa90",
  "start": 52.246,
  "end": 54.146,
  "text": "নিয়মিত কমিশন সভায়"
 },
 {
  "speaker": "f280a",
  "start": 54.53,
  "end": 56.03,
  "text": "থেকে বঞ্চিত হয়ে থাকে"
 },
 {
  "speaker": "9fa90",
  "start": 56.478,
  "end": 58.478,
  "text": "সমাবেশ স্থগিত করার কথা"
 },
 {
  "speaker": "f280a",
  "start": 58.856,
  "end": 59.956,
  "text": "অনিলের আঁকা"
 },
 {
  "speaker": "9fa90",
  "start": 60.107,
  "end": 63.007,
  "text": "একটি আধুনিক চিকিৎসার হাসপাতাল"
 },
 {
  "speaker": "f280a",
  "start": 63.224,
  "end": 65.124,
  "text": "তার মতো প্রায় আড়াইশ শিক্ষার্থী"
 },
 {
  "speaker": "9fa90",
  "start": 65.743,
  "end": 67.043,
  "text": "কৌণিক দুরত্ব"
 },
 {
  "speaker": "f280a",
  "start": 67.35,
  "end": 68.85,
  "text": "তবে কই মোষ"
 },
 {
  "speaker": "9fa90",
  "start": 69.158,
  "end": 71.458,
  "text": "ও ছোটবেলা থেকেই"
 },
 {
  "speaker": "f280a",
  "start": 71.709,
  "end": 72.709,
  "text": "হিন্দু সমাজ"
 },
 {
  "speaker": "9fa90",
  "start": 73.23,
  "end": 75.03,
  "text": "অংশ নেয়া শিক্ষার্থীরা"
 }
]