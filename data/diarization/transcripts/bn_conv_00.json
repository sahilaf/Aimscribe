[
 {
  "speaker": "2b883",
  "start": 0.5,
  "end": 2.6,
  "text": "তবে ভিসার সাক্ষাতকারের সময়ে"
 },
 {
  "speaker": "61820",
  "start": 1.251,
  "end": 2.551,
  "text": "অবমুক্ত করার মাধ্যমে"
 },
 {
  "speaker": "61820",
  "start": 2.736,
  "end": 3.536,
  "text": "রাগের চোটে"
 },
 {
  "speaker": "2b883",
  "start": 4.07,
  "end": 4.97,
  "text": "দেখিতে পায় না"
 },
 {
  "speaker": "61820",
  "start": 5.414,
  "end": 6.914,
  "text": "অস্বচ্ছ বিষয়গুলো নিয়ে"
 },
 {
  "speaker": "2b883",
  "start": 7.256,
  "end": 9.756,
  "text": "প্রদর্শনীতে ল্যান্ড অব ফ্যান্টাসি নামে"
 },
 {
  "speaker": "61820",
  "start": 9.986,
  "end": 11.486,
  "text": "পরে আশুলিয়া থানা পুলিশ"
 },
 {
  "speaker": "2b883",
  "start": 11.837,
  "end": 12.737,
  "text": "কাঁদানে গ্যাস"
 },
 {
  "speaker": "61820",
  "start": 13.464,
  "end": 14.464,
  "text": "পাঠকের মাঝ থেকে"
 },
 {
  "speaker": "2b883",
  "start": 15.375,
  "end": 17.275,
  "text": "শিল্পকেন্দ্র হিসেবে কাজ করে"
 },
 {
  "speaker": "61820",
  "start": 17.749,
  "end": 18.749,
  "text": "পেনসিল স্কেচের"
 },
 {
  "speaker": "2b883",
  "start": 18.255,
  "end": 19.155,
  "text": "আব্দুস সবুর"
 },
 {
  "speaker": "61820",
  "start": 18.849,
  "end": 20.549,
  "text": "মাসির বাড়িতে গিয়েছিল শেফালি"
 },
 {
  "speaker": "2b883",
  "start": 21.285,
  "end": 22.385,
  "text": "প্রধান ব্যান্ড"
 },
 {
  "speaker": "61820",
  "start": 22.01,
  "end": 23.51,
  "text": "যথারীতি এবারও ছবিটি ছিল"
 },
 {
  "speaker": "2b883",
  "start": 24.479,
  "end": 25.579,
  "text": "অজানা এক কারণে"
 },
 {
  "speaker": "61820",
  "start": 25.492,
  "end": 27.592,
  "text": "কিছুদূর চলতেই লোহার সেতু"
 },
 {
  "speaker": "2b883",
  "start": 26.294,
  "end": 27.194,
  "text": "সব দেখতে পান"
 },
 {
  "speaker": "2b883",
  "start": 27.294,
  "end": 29.294,
  "text": "হরতালের পরিবর্তে"
 },
 {
  "speaker": "61820",
  "start": 29.45,
  "end": 30.95,
  "text": "ভালো কিছু করতে পারছি না"
 },
 {
  "speaker": "2b883",
  "start": 31.619,
  "end": 32.419,
  "text": "দুটো চপ"
 },
 {
  "speaker": "61820",
  "start": 33.322,
  "end": 35.022,
  "text": "এজলাস কক্ষের সামনে"
 },
 {
  "speaker": "2b883",
  "start": 35.617,
  "end": 38.917,
  "text": "সে নিশ্চয়তা দেওয়া কঠিন"
 },
 {
  "speaker": "61820",
  "start": 39.152,
  "end": 40.652,
  "text": "এই গ্রন্থাগারের বই সংখ্যা"
 },
 {
  "speaker": "2b883",
  "start": 40.964,
  "end": 42.164,
  "text": "বহুলাংশে কমে গেছে"
 },
 {
  "speaker": "61820",
  "start": 42.749,
  "end": 45.049,
  "text": "ব্যাপন প্রক্রিয়া চলতে থাকে"
 },
 {
  "speaker": "2b883",
  "start": 46.016,
  "end": 47.216,
  "text": "এর বিচার না হলে"
 },
 {
  "speaker": "61820",
  "start": 47.918,
  "end": 49.018,
  "text": "নিহতের নাম ঠিকানা"
 },
 {
  "speaker": "2b883",
  "start": 49.857,
  "end": 51.057,
  "text": "এটাও জানিয়ে দিয়েছেন"
 },
 {
  "speaker": "61820",
  "start": 51.846,
  "end": 52.746,
  "text": "একটু দেখল"
 },
 {
  "speaker": "2b883",
  "start": 53.134,
  "end": 54.734,
  "text": "শিশুদের সংখ্যাই বেশি"
 },
 {
  "speaker": "61820",
  "start": 54.365,
  "end": 55.365,
  "text": "পরিদের সঙ্গে থাকে"
 },
 {
  "speaker": "2b883",
  "start": 55.199,
  "end": 56.699,
  "text": "আবার সে বড়লোক হওয়ার কথা"
 },
 {
  "speaker": "61820",
  "start": 57.494,
  "end": 59.194,
  "text": "সহিংসতায় একজন নিহত হয়েছেন"
 },
 {
  "speaker": "2b883",
  "start": 59.779,
  "end": 60.979,
  "text": "এই পুরুর বংশ"
 },
 {
  "speaker": "61820",
  "start": 61.733,
  "end": 64.533,
  "text": "মা আপন মনে আঙুল গুনছিলেন"
 },
 {
  "speaker": "2b883",
  "start": 65.105,
  "end": 66.005,
  "text": "নিতে হবে আজ"
 },
 {
  "speaker": "61820",
  "start": 66.644,
  "end": 68.444,
  "text": "কিন্তু সেই সঙ্গেই বলেছেন"
 },
 {
  "speaker": "2b883",
  "start": 68.004,
  "end": 71.604,
  "text": "তিন ওভার চার বল বাকি থাকতেই তারা জয়ের লক্ষ্যে পৌঁছে যায়"
 },
 {
  "speaker": "61820",
  "start": 72.599,
  "end": 74.499,
  "text": "বুড়িগঙ্গায় গণ গোসল করেন"
 },
 {
  "speaker": "2b883",
  "start": 74.2,
  "end": 75.4,
  "text": "সেগুলো বাস্তবায়ন করা"
 }
]