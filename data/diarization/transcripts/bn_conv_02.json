[
 {
  "speaker": "0edef",
  "start": 0.5,
  "end": 5.9,
  "text": "বিভিন্ন শ্রমিক সংগঠন রয়েছে যাদের বেশিরভাগই কোন না কোন রাজনৈতিক দলের সাথে সম্পৃক্ত"
 },
 {
  "speaker": "16877",
  "start": 6.836,
  "end": 8.336,
  "text": "এই দুইভাবে পাওয়া যায়"
 },
 {
  "speaker": "0edef",
  "start": 8.915,
  "end": 10.115,
  "text": "নানান অভিযোগে"
 },
 {
  "speaker": "16877",
  "start": 10.295,
  "end": 11.795,
  "text": "উৎপাদন করা সম্ভব"
 },
 {
  "speaker": "0edef",
  "start": 12.201,
  "end": 13.201,
  "text": "সভা শেষে"
 },
 {
  "speaker": "16877",
  "start": 13.619,
  "end": 14.719,
  "text": "প্রচারণার জন্য"
 },
 {
  "speaker": "0edef",
  "start": 15.172,
  "end": 16.272,
  "text": "পিষ্ট আমজনতা"
 },
 {
  "speaker": "16877",
  "start": 16.485,
  "end": 18.085,
  "text": "একদিন হঠাৎ"
 },
 {
  "speaker": "0edef",
  "start": 19.05,
  "end": 20.15,
  "text": "দ্বারকায় নিয়ে যান"
 },
 {
  "speaker": "16877",
  "start": 21.002,
  "end": 22.202,
  "text": "দমকা হাওয়াসহ"
 },
 {
  "speaker": "0edef",
  "start": 23.044,
  "end": 24.444,
  "text": "মেয়েদের ধর্ষণ করবে"
 },
 {
  "speaker": "16877",
  "start": 25.13,
  "end": 26.13,
  "text": "এই মাসের মধ্যে"
 },
 {
  "speaker": "0edef",
  "start": 26.957,
  "end": 28.057,
  "text": "খুব গোপন ছিল না"
 },
 {
  "speaker": "16877",
  "start": 28.061,
  "end": 29.161,
  "text": "ভর্তি রয়েছেন"
 },
 {
  "speaker": "0edef",
  "start": 29.622,
  "end": 31.722,
  "text": "সাহিত্যের পক্ষে ইহার অপেক্ষা"
 },
 {
  "speaker": "16877",
  "start": 32.134,
  "end": 34.234,
  "text": "বাংলাদেশের মুক্তিযুদ্ধ চলার সময়"
 },
 {
  "speaker": "0edef",
  "start": 34.831,
  "end": 36.431,
  "text": "দলকে সহজ জয়"
 },
 {
  "speaker": "16877",
  "start": 37.344,
  "end": 38.244,
  "text": "ভিতরে বসে"
 },
 {
  "speaker": "0edef",
  "start": 38.976,
  "end": 41.176,
  "text": "কতটা বৈষম্য হ্রাস করতে পেরেছে"
 },
 {
  "speaker": "16877",
  "start": 41.599,
  "end": 43.799,
  "text": "সরি বলতে থাকবে"
 },
 {
  "speaker": "0edef",
  "start": 43.694,
  "end": 45.494,
  "text": "রাজশক্তির প্রতি ভয়"
 },
 {
  "speaker": "16877",
  "start": 46.42,
  "end": 47.12,
  "text": "দুজনে"
 },
 {
  "speaker": "0edef",
  "start": 48.114,
  "end": 50.414,
  "text": "জন্ম থেকেই দেখে আসছে শেফালি"
 },
 {
  "speaker": "16877",
  "start": 49.407,
  "end": 50.507,
  "text": "এক দল ডাকাত"
 },
 {
  "speaker": "16877",
  "start": 50.696,
  "end": 52.396,
  "text": "মকবুল মোর্শেদ আহমেদ"
 },
 {
  "speaker": "0edef",
  "start": 52.449,
  "end": 52.949,
  "text": "সময়"
 },
 {
  "speaker": "16877",
  "start": 53.3,
  "end": 54.6,
  "text": "মেঘনার পানি ছিল"
 },
 {
  "speaker": "0edef",
  "start": 55.493,
  "end": 56.093,
  "text": "ময়ুর"
 },
 {
  "speaker": "16877",
  "start": 56.108,
  "end": 59.208,
  "text": "হাজার হাজার অভিযুক্ত করা হয়েছে"
 },
 {
  "speaker": "0edef",
  "start": 59.582,
  "end": 60.982,
  "text": "ঘটে দ্বিতীয় বিস্ফোরণ"
 },
 {
  "speaker": "16877",
  "start": 61.982,
  "end": 63.982,
  "text": "সঠিক সংস্কৃতিচর্চা থেকেও"
 },
 {
  "speaker": "0edef",
  "start": 64.345,
  "end": 65.345,
  "text": "গোসল করতেন"
 },
 {
  "speaker": "16877",
  "start": 65.52,
  "end": 67.92,
  "text": "পাশাপাশি সংসদীয় গণতন্ত্র উন্নয়ন"
 },
 {
  "speaker": "0edef",
  "start": 67.93,
  "end": 69.43,
  "text": "নিয়ে আলোচনা করব"
 },
 {
  "speaker": "16877",
  "start": 70.141,
  "end": 71.141,
  "text": "কামাল লোহান"
 },
 {
  "speaker": "0edef",
  "start": 71.558,
  "end": 74.158,
  "text": "জলাধার ভুমিকম্পের আশঙ্কা বাড়াতে পারে"
 },
 {
  "speaker": "16877",
  "start": 74.4,
  "end": 76.4,
  "text": "প্রতারণা ও অপরাধের কথা"
 }
]