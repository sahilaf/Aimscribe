[
 {
  "speaker": "6fb36",
  "start": 0.5,
  "end": 2.7,
  "text": "হিন্দু মুসলমান উভয় সমপ্রদায়েরই"
 },
 {
  "speaker": "1cb75",
  "start": 2.931,
  "end": 5.031,
  "text": "বুড়িগঙ্গা থেকে শীতলক্ষ্যা হয়ে"
 },
 {
  "speaker": "6fb36",
  "start": 5.985,
  "end": 7.685,
  "text": "রাজধানী বুয়েন্স আয়ার্স থেকে"
 },
 {
  "speaker": "1cb75",
  "start": 8.328,
  "end": 10.428,
  "text": "ড্রইংরুমে নিজ কন্যাকে"
 },
 {
  "speaker": "6fb36",
  "start": 11.406,
  "end": 14.406,
  "text": "আইহো ভারতের"
 },
 {
  "speaker": "1cb75",
  "start": 13.846,
  "end": 14.646,
  "text": "বদ"
 },
 {
  "speaker": "6fb36",
  "start": 15.008,
  "end": 17.308,
  "text": "তার বিচার হবে কিশোর আদালতে"
 },
 {
  "speaker": "1cb75",
  "start": 18.213,
  "end": 20.313,
  "text": "কাল বাসবে না"
 },
 {
  "speaker": "6fb36",
  "start": 21.194,
  "end": 26.694,
  "text": "রণ হৈতে প্রাণ লয়ে"
 },
 {
  "speaker": "1cb75",
  "start": 26.899,
  "end": 27.899,
  "text": "আমাশয়"
 },
 {
  "speaker": "6fb36",
  "start": 28.555,
  "end": 30.355,
  "text": "ছেলেদের জন্যও শিক্ষা"
 },
 {
  "speaker": "1cb75",
  "start": 30.705,
  "end": 32.605,
  "text": "আসলে এই ধারাটা যখন"
 },
 {
  "speaker": "6fb36",
  "start": 33.548,
  "end": 34.648,
  "text": "লেবানন থেকে"
 },
 {
  "speaker": "1cb75",
  "start": 34.873,
  "end": 37.773,
  "text": "ঢাকা ও তার আশেপাশের এলাকায়"
 },
 {
  "speaker": "6fb36",
  "start": 37.817,
  "end": 41.017,
  "text": "আমরা মামলার প্রমাণ দেওয়া সত্ত্বেও"
 },
 {
  "speaker": "1cb75",
  "start": 41.871,
  "end": 43.871,
  "text": "নিয়মিত নজর রাখেন"
 },
 {
  "speaker": "6fb36",
  "start": 44.196,
  "end": 45.396,
  "text": "কারণ দেশটাকে"
 },
 {
  "speaker": "1cb75",
  "start": 45.624,
  "end": 46.624,
  "text": "অবতার বলে"
 },
 {
  "speaker": "6fb36",
  "start": 46.199,
  "end": 47.899,
  "text": "একটা খারাপ বছর"
 },
 {
  "speaker": "1cb75",
  "start": 48.335,
  "end": 49.335,
  "text": "প্রস্তুতি নিচ্ছে"
 },
 {
  "speaker": "6fb36",
  "start": 48.908,
  "end": 50.808,
  "text": "হত্যা মামলার প্রধান আসামি"
 },
 {
  "speaker": "1cb75",
  "start": 51.624,
  "end": 54.224,
  "text": "তাকিয়ে থাকি ধমকালে"
 },
 {
  "speaker": "6fb36",
  "start": 53.785,
  "end": 55.085,
  "text": "কঠিন বোধ হইল না"
 },
 {
  "speaker": "1cb75",
  "start": 55.66,
  "end": 57.56,
  "text": "মা র বা আল্লাহ তায়ালার"
 },
 {
  "speaker": "6fb36",
  "start": 58.45,
  "end": 59.35,
  "text": "চুল গজানো"
 },
 {
  "speaker": "1cb75",
  "start": 59.899,
  "end": 63.299,
  "text": "ট্রেড ইউনিয়নকারী শ্রমিকদের"
 },
 {
  "speaker": "6fb36",
  "start": 63.542,
  "end": 64.642,
  "text": "মাস কয়েক হয়"
 },
 {
  "speaker": "1cb75",
  "start": 65.48,
  "end": 69.38,
  "text": "তিনি লোকগান সংগ্রহ করেছেন"
 },
 {
  "speaker": "6fb36",
  "start": 70.345,
  "end": 71.245,
  "text": "একটি চেয়ারে"
 },
 {
  "speaker": "1cb75",
  "start": 72.098,
  "end": 74.298,
  "text": "ভাইরে সুবল"
 },
 {
  "speaker": "6fb36",
  "start": 72.941,
  "end": 74.441,
  "text": "উত্তম কুমারের সঙ্গে"
 }
]