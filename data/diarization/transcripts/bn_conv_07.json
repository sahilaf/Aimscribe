[
 {
  "speaker": "7ec1c",
  "start": 0.5,
  "end": 2.9,
  "text": "আমাদের পক্ষে কতোখানি সহায়ক"
 },
 {
  "speaker": "809cd",
  "start": 3.554,
  "end": 4.854,
  "text": "তাহলে তার প্রিয় দীপু"
 },
 {
  "speaker": "7ec1c",
  "start": 5.131,
  "end": 7.031,
  "text": "ভারত সফরে যাবে বাংলাদেশ"
 },
 {
  "speaker": "809cd",
  "start": 8.002,
  "end": 9.502,
  "text": "এবং এয়ারবোম ট্রুপস নিয়ে"
 },
 {
  "speaker": "7ec1c",
  "start": 10.162,
  "end": 12.962,
  "text": "চরম উত্তেজনা বিরাজ করছে"
 },
 {
  "speaker": "809cd",
  "start": 13.859,
  "end": 15.059,
  "text": "এই গ্রন্থাগারে"
 },
 {
  "speaker": "7ec1c",
  "start": 15.975,
  "end": 17.475,
  "text": "থাকবে গ্রাম্য পুলিশ"
 },
 {
  "speaker": "809cd",
  "start": 17.747,
  "end": 20.047,
  "text": "সিইউএফএল ও কাফকো"
 },
 {
  "speaker": "7ec1c",
  "start": 20.117,
  "end": 21.417,
  "text": "একদমই দেখা যায়নি"
 },
 {
  "speaker": "1a2a1",
  "start": 20.846,
  "end": 22.346,
  "text": "নিউইয়র্কে আছি"
 },
 {
  "speaker": "809cd",
  "start": 22.593,
  "end": 23.793,
  "text": "নিঃশ্বাস ফেলছিল"
 },
 {
  "speaker": "7ec1c",
  "start": 24.221,
  "end": 25.321,
  "text": "প্রসিকিউশন"
 },
 {
  "speaker": "809cd",
  "start": 26.272,
  "end": 28.072,
  "text": "সান্তিয়াগো বার্নাবেউয়ে"
 },
 {
  "speaker": "7ec1c",
  "start": 28.794,
  "end": 31.794,
  "text": "সড়ক অবরোধের চেষ্টা করে অবরোধকারীর"
 },
 {
  "speaker": "809cd",
  "start": 32.094,
  "end": 33.694,
  "text": "সে কারণে তিনি মনে করেন"
 },
 {
  "speaker": "1a2a1",
  "start": 34.54,
  "end": 35.74,
  "text": "নোটিস দেয়া হলে"
 },
 {
  "speaker": "809cd",
  "start": 36.579,
  "end": 37.379,
  "text": "শিক্ষা করা"
 },
 {
  "speaker": "7ec1c",
  "start": 38.326,
  "end": 39.426,
  "text": "অন্যান্য পানীয়"
 },
 {
  "speaker": "1a2a1",
  "start": 39.984,
  "end": 41.384,
  "text": "আসামিরা অক্ষত"
 },
 {
  "speaker": "809cd",
  "start": 41.601,
  "end": 43.101,
  "text": "মুখ রক্তে মাখামাখি"
 },
 {
  "speaker": "7ec1c",
  "start": 43.404,
  "end": 44.504,
  "text": "বলা হয় কাকে"
 },
 {
  "speaker": "1a2a1",
  "start": 45.292,
  "end": 47.492,
  "text": "বাবা খুব পিউরিটান ছিলেন"
 },
 {
  "speaker": "809cd",
  "start": 47.808,
  "end": 48.808,
  "text": "উলম্ব নিয়ন্ত্রণ"
 },
 {
  "speaker": "7ec1c",
  "start": 49.133,
  "end": 50.333,
  "text": "মিছিলের চরিত্র"
 },
 {
  "speaker": "809cd",
  "start": 51.176,
  "end": 52.376,
  "text": "পূবদিকের আকাশ"
 },
 {
  "speaker": "1a2a1",
  "start": 52.639,
  "end": 54.039,
  "text": "তার কথাটা ভেবে দেখুন"
 },
 {
  "speaker": "809cd",
  "start": 54.869,
  "end": 56.669,
  "text": "গুপি থতমত খেযে বলল"
 },
 {
  "speaker": "1a2a1",
  "start": 56.965,
  "end": 58.165,
  "text": "মা সায়রা বেগম"
 },
 {
  "speaker": "809cd",
  "start": 58.574,
  "end": 60.474,
  "text": "বল বীর চির উন্নত মম শির"
 },
 {
  "speaker": "1a2a1",
  "start": 60.097,
  "end": 61.397,
  "text": "ভারী যন্ত্রপাতির"
 },
 {
  "speaker": "809cd",
  "start": 62.38,
  "end": 63.98,
  "text": "তৃতীয় সংখ্যার জন্য লিখেছিলেন"
 },
 {
  "speaker": "7ec1c",
  "start": 63.706,
  "end": 65.706,
  "text": "মিছিল থেকে পুলিশকে লক্ষ্য করে"
 },
 {
  "speaker": "809cd",
  "start": 65.468,
  "end": 66.968,
  "text": "তবে নরেন্দ্র মোদি"
 },
 {
  "speaker": "1a2a1",
  "start": 67.313,
  "end": 68.113,
  "text": "সেই বিবাহ"
 },
 {
  "speaker": "809cd",
  "start": 68.453,
  "end": 70.153,
  "text": "রাসূল সা বলেন"
 },
 {
  "speaker": "7ec1c",
  "start": 70.542,
  "end": 73.442,
  "text": "প্রাইমর্ডিয়াল আইসোটোপ হল"
 },
 {
  "speaker": "1a2a1",
  "start": 74.145,
  "end": 75.445,
  "text": "আউটের আবেদন"
 }
]