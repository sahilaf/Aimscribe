[
 {
  "speaker": "1b359",
  "start": 0.5,
  "end": 1.6,
  "text": "হরতাল শেষে"
 },
 {
  "speaker": "43199",
  "start": 2.018,
  "end": 3.518,
  "text": "সমর্থন দিয়েছেন পুতিন"
 },
 {
  "speaker": "15a75",
  "start": 3.023,
  "end": 4.323,
  "text": "শুনতে পাওয়া গেছে"
 },
 {
  "speaker": "43199",
  "start": 4.004,
  "end": 5.504,
  "text": "এসব নিয়ে প্রতিনিয়ত"
 },
 {
  "speaker": "15a75",
  "start": 5.835,
  "end": 10.235,
  "text": "তবে কাজালের মা মানাল জানান"
 },
 {
  "speaker": "43199",
  "start": 10.772,
  "end": 11.772,
  "text": "স্টুডেন্ট কেয়ার"
 },
 {
  "speaker": "1b359",
  "start": 12.593,
  "end": 13.893,
  "text": "যুগ্ম মহাসচিব"
 },
 {
  "speaker": "43199",
  "start": 14.666,
  "end": 17.666,
  "text": "মো মোজাম্মেল হোসেনের নেতৃত্বে"
 },
 {
  "speaker": "15a75",
  "start": 17.909,
  "end": 19.709,
  "text": "পানি সম্পদ মন্ত্রনালয়ের"
 },
 {
  "speaker": "1b359",
  "start": 20.108,
  "end": 21.708,
  "text": "ডাকাতদল অস্ত্রের মুখে"
 },
 {
  "speaker": "15a75",
  "start": 21.392,
  "end": 23.192,
  "text": "মূল উপজীব্য করে"
 },
 {
  "speaker": "43199",
  "start": 23.409,
  "end": 24.409,
  "text": "রমনা বিভাগে"
 },
 {
  "speaker": "1b359",
  "start": 25.407,
  "end": 28.007,
  "text": "পুঁথিসমূহের অনেকগুলো রচনার পিছনে"
 },
 {
  "speaker": "15a75",
  "start": 28.165,
  "end": 29.965,
  "text": "তার প্রথম স্ত্রীর কাছে"
 },
 {
  "speaker": "1b359",
  "start": 30.708,
  "end": 33.208,
  "text": "বিকল্পধারার কর্মী সমাবেশে"
 },
 {
  "speaker": "15a75",
  "start": 33.437,
  "end": 35.537,
  "text": "বৈঠক শেষে জাপানি মন্ত্রী"
 },
 {
  "speaker": "43199",
  "start": 36.084,
  "end": 37.684,
  "text": "একইসাথে তিনি বলেছেন"
 },
 {
  "speaker": "15a75",
  "start": 37.43,
  "end": 38.73,
  "text": "আসছে এপ্রিলেই"
 },
 {
  "speaker": "43199",
  "start": 39.651,
  "end": 40.751,
  "text": "খুব ভালো করে"
 },
 {
  "speaker": "15a75",
  "start": 41.07,
  "end": 43.17,
  "text": "নিজের গল্প থেকে"
 },
 {
  "speaker": "1b359",
  "start": 44.102,
  "end": 50.702,
  "text": "যৌক্তিকতা ও বাস্তবতার ভিত্তিতে সুন্দরবনকে রক্ষা করে যেখানে করা যায় সেখানেই এ কেন্দ্র করা উচিত"
 },
 {
  "speaker": "43199",
  "start": 51.495,
  "end": 53.895,
  "text": "যশোরের সহকারী রিটার্নিং কর্মকর্তা"
 },
 {
  "speaker": "1b359",
  "start": 54.551,
  "end": 55.851,
  "text": "প্রথমে সংগ্রহ করি"
 },
 {
  "speaker": "43199",
  "start": 56.42,
  "end": 58.42,
  "text": "লিন প্রথমে জানিয়েছিলেন"
 },
 {
  "speaker": "15a75",
  "start": 58.868,
  "end": 60.768,
  "text": "এরই মধ্যে ভিডিওটি নিয়ে"
 },
 {
  "speaker": "1b359",
  "start": 60.858,
  "end": 61.858,
  "text": "কেজি দরে কিনে"
 },
 {
  "speaker": "43199",
  "start": 62.249,
  "end": 63.549,
  "text": "সি আই ই উপাধি"
 },
 {
  "speaker": "1b359",
  "start": 64.224,
  "end": 65.424,
  "text": "বঞ্চিত হচ্ছেন"
 },
 {
  "speaker": "43199",
  "start": 66.108,
  "end": 66.708,
  "text": "এই যে"
 },
 {
  "speaker": "1b359",
  "start": 67.219,
  "end": 68.419,
  "text": "ক্যানসারে মরছি"
 },
 {
  "speaker": "15a75",
  "start": 69.035,
  "end": 71.735,
  "text": "মনোনয়নপত্র জমা দিতে পারেননি"
 },
 {
  "speaker": "43199",
  "start": 72.048,
  "end": 73.748,
  "text": "আবারো তাদের বাড়িতে নিয়ে আসে"
 },
 {
  "speaker": "15a75",
  "start": 74.605,
  "end": 76.205,
  "text": "কারও সঙ্গে একটা ফ্ল্যাট"
 }
]