[
 {
  "speaker": "7f2ef",
  "start": 0.5,
  "end": 2.7,
  "text": "চ্যাম্পিয়ন হওয়ায় তাদের অভিনন্দন"
 },
 {
  "speaker": "12702",
  "start": 3.699,
  "end": 4.799,
  "text": "অন্ধ হয়ে পড়েন"
 },
 {
  "speaker": "7f2ef",
  "start": 5.474,
  "end": 7.074,
  "text": "সেখানে গিয়ে অবস্থা দেখে"
 },
 {
  "speaker": "a46e2",
  "start": 6.767,
  "end": 8.067,
  "text": "যান চলাচল শুরু হয়েছে"
 },
 {
  "speaker": "7f2ef",
  "start": 8.716,
  "end": 11.116,
  "text": "দেশের দুই শীর্ষস্থানীয় প্রতিষ্ঠানের"
 },
 {
  "speaker": "12702",
  "start": 11.705,
  "end": 13.105,
  "text": "পল্লবীর পলাশ নগরে"
 },
 {
  "speaker": "a46e2",
  "start": 13.253,
  "end": 14.753,
  "text": "শিরোনামচিহ্নিত অধ্যায়ের পর"
 },
 {
  "speaker": "7f2ef",
  "start": 14.687,
  "end": 15.887,
  "text": "আমার সামনেই"
 },
 {
  "speaker": "12702",
  "start": 16.744,
  "end": 18.444,
  "text": "দৃঢ়ভাবে মান যাচাইয়ের"
 },
 {
  "speaker": "a46e2",
  "start": 19.297,
  "end": 20.897,
  "text": "খাওয়া পরার খরচ জোটাতে"
 },
 {
  "speaker": "7f2ef",
  "start": 21.243,
  "end": 22.343,
  "text": "সমস্ত কাগজ"
 },
 {
  "speaker": "a46e2",
  "start": 23.052,
  "end": 24.752,
  "text": "তাদের সবাই বিমানবাহিনীর সদস্য"
 },
 {
  "speaker": "7f2ef",
  "start": 24.954,
  "end": 26.054,
  "text": "গ্রেপ্তার করেছিল"
 },
 {
  "speaker": "a46e2",
  "start": 26.333,
  "end": 27.633,
  "text": "সুরকার সঙ্গীত পরিচালক"
 },
 {
  "speaker": "12702",
  "start": 28.231,
  "end": 30.031,
  "text": "একটি পূর্ণ প্রতিযোগিতামূলক বাজারে"
 },
 {
  "speaker": "a46e2",
  "start": 30.643,
  "end": 33.243,
  "text": "জানুয়ারিতে আনবার প্রদেশ বাদ দিয়ে"
 },
 {
  "speaker": "7f2ef",
  "start": 33.54,
  "end": 34.74,
  "text": "আনন্দ পেতেন বেশি"
 },
 {
  "speaker": "a46e2",
  "start": 34.297,
  "end": 35.197,
  "text": "কষ্টও পেয়েছেন"
 },
 {
  "speaker": "7f2ef",
  "start": 35.888,
  "end": 37.688,
  "text": "ব্যবসাটি আরম্ভ করা ভালো"
 },
 {
  "speaker": "a46e2",
  "start": 38.351,
  "end": 39.451,
  "text": "আলতাফ চৌধুরী"
 },
 {
  "speaker": "12702",
  "start": 39.786,
  "end": 41.686,
  "text": "মানুষকে উদ্ধার করতে পারে"
 },
 {
  "speaker": "a46e2",
  "start": 42.644,
  "end": 43.744,
  "text": "আপনি সঠিক বলেছেন"
 },
 {
  "speaker": "7f2ef",
  "start": 44.253,
  "end": 45.653,
  "text": "যুদ্ধ চালিয়ে যাবেন"
 },
 {
  "speaker": "a46e2",
  "start": 46.464,
  "end": 51.164,
  "text": "এসব কমিটির সভাপতি উপজেলা নির্বাহী কর্মকর্তা আর উপদেষ্টা সংসদ সদস্যরা"
 },
 {
  "speaker": "7f2ef",
  "start": 50.853,
  "end": 52.753,
  "text": "বাড়িতে কেউ ঢুকলেই বলত"
 },
 {
  "speaker": "12702",
  "start": 52.958,
  "end": 53.858,
  "text": "ছ মাস আগে"
 },
 {
  "speaker": "7f2ef",
  "start": 54.826,
  "end": 56.126,
  "text": "বেসিকের জন্য লেখা"
 },
 {
  "speaker": "a46e2",
  "start": 56.868,
  "end": 57.968,
  "text": "তার পরও তিনি আমাকে"
 },
 {
  "speaker": "7f2ef",
  "start": 58.737,
  "end": 59.837,
  "text": "টলস্টয়ের অনেক"
 },
 {
  "speaker": "12702",
  "start": 60.176,
  "end": 62.376,
  "text": "নতুন নতুন পোশাকের সমারহ"
 },
 {
  "speaker": "a46e2",
  "start": 60.953,
  "end": 62.253,
  "text": "ফ্রি কিক পায় সেল্তা"
 },
 {
  "speaker": "7f2ef",
  "start": 62.866,
  "end": 63.866,
  "text": "চুল শ্যাম্পু করে"
 },
 {
  "speaker": "a46e2",
  "start": 64.389,
  "end": 66.589,
  "text": "নওয়াজের বাগানবাড়িটির অবস্থান"
 },
 {
  "speaker": "12702",
  "start": 67.519,
  "end": 68.819,
  "text": "প্রতিনিধি সেলিমকে"
 },
 {
  "speaker": "a46e2",
  "start": 68.53,
  "end": 70.13,
  "text": "তাকে বিক্রি করে দিতে পারে দলটি"
 },
 {
  "speaker": "12702",
  "start": 69.966,
  "end": 72.966,
  "text": "গরিবেরা এমনভাবে মুখ বিকৃত করে"
 },
 {
  "speaker": "a46e2",
  "start": 73.268,
  "end": 74.968,
  "text": "দুদক থেকে নোটিশ দেয়া হয়"
 }
]